# newfc 环境变量示例(开发/部署均用本文件作模板;systemd 部署见 deploy/newfc.service)
# 复制此文件为 .env 并按需填写:
#   cp .env.example .env
#
# 加载方式: 后端启动时自动读取 backend/.env 与仓库根目录 .env(前者优先)，
# `npm start` / `npm run dev` / systemd 均生效。
# 已经显式 export 的环境变量优先级更高，不会被本文件覆盖(空值也算已设置)。

# 服务端口与监听地址 (可选，默认 127.0.0.1:3760；3748 属于 newbd，不得复用)
# NEWFC_HOST=127.0.0.1
# NEWFC_PORT=3760
# 直连保持 0；只有服务确实位于可信反向代理后时才设为代理跳数（单层 nginx 反代时设 1）
# NEWFC_TRUST_PROXY=0

# 登录账号不在本文件配置：用户、角色与组织范围存于数据库，首个管理员由运维显式创建
#   cd /root/newfc/backend && NEWFC_DATA_DIR=/data/newfc-data npm run admin:create -- --username admin
# 不存在默认口令、关鉴权开关或环境变量登录旁路(旧的 NEWFC_ACCESS_* / NEWFC_DISABLE_AUTH 已废弃，设置了只会告警)。

# 数据存储目录 (可选，默认 <cwd>/data，即 backend/data)。生产使用独立持久目录 /data/newfc-data；
# 绝不指向 newbd 或 lishui 的数据目录。
# NEWFC_DATA_DIR="/data/newfc-data"


# ---------------------------------------------------------------------------
# AI 助手模型配置 (全部可选)
#
# 不配置 AI_BASE_URL 时助手仍然可用：事实查询、差异归因、报告组稿、导入诊断、
# 异常检查、预览/确认全部由后端确定性计算，只是回答文字使用模板而非模型改写。
# 配置后模型会自主调用只读工具做意图路由，并把自然语言写操作请求转成预览参数。
# 模型永远不能直接写库：所有写入仍需 preview → confirm 并携带确认令牌。
# ---------------------------------------------------------------------------

# OpenAI 兼容接口根地址；填 /chat/completions 结尾的完整地址也可以。
# 本地推理服务示例: http://127.0.0.1:11434/v1
# AI_BASE_URL="https://api.example.com/v1"

# 注意: 明文 http:// 地址会把密钥与提示词内容(组织/科目名称、工具返回的金额事实)
# 以未加密方式发往该地址。远程地址默认必须使用 https；仅可信内网场景可显式开启下项。
# AI_ALLOW_INSECURE_HTTP=0

# Bearer 密钥；本地无鉴权的兼容服务可以省略。请勿提交真实密钥。
# AI_API_KEY=""

# 模型名，默认 gpt-4o-mini。必须支持 function calling 才能启用模型路由。
# AI_MODEL="gpt-4o-mini"

# 供应商标识，当前仅使用 OpenAI-compatible 协议。
# AI_PROVIDER="openai-compatible"

# 首字/空闲超时(毫秒)，10 ~ 120000，默认 15000。
# 只约束「发出请求到响应头返回」以及流式响应中相邻两块数据的间隔，
# 不会打断正在输出的长回答(整轮上限见 AI_TOTAL_TIMEOUT_MS)。
# AI_TIMEOUT_MS=15000

# 单次模型请求的整轮上限(毫秒)，默认 max(AI_TIMEOUT_MS × 8, 120000)，上限 1800000。
# 非流式请求(AI_STREAM=0)以这个值为唯一期限；本地慢模型输出很长时可调大。
# AI_TOTAL_TIMEOUT_MS=120000

# 是否使用流式响应，默认开启；设为 0 退回一次性响应(排查供应商兼容问题时使用)。
# AI_STREAM=1

# 预览 action 有效期(毫秒)，10 ~ 86400000，默认 900000(15 分钟)。
# AI_ACTION_TTL_MS=900000

# AI_RATE_LIMIT_PER_MIN=30

# 进程内同时进行的模型外呼上限，默认 4。超出时本次问答立即改用规则查询(不排队)。
# NEWFC_MODEL_CONCURRENCY=4

# 同时运行的持久任务(导入、报告、重算等)上限，默认 1，1 ~ 8；超出排队。
# NEWFC_JOB_CONCURRENCY=1

# 非标 Excel 清洗向导是否允许把脱敏后的工作簿结构样本发给上述模型。
# 设为 0 时只关闭清洗推荐，不影响 AI 助手和完整手工清洗流程。
# NEWFC_CLEANING_AI=1

# 导入与清洗资源上限（可选）。行数按数据行计，不含 1 行表头(OPEN-04 基线见 docs/acceptance-records.md T-2)。
# NEWFC_MAX_IMPORT_ROWS=20000
# NEWFC_MAX_IMPORT_ERRORS=200
# NEWFC_MAX_UPLOAD_BYTES=10485760
# NEWFC_CLEANING_UPLOAD_TTL_MS=86400000
# NEWFC_CLEANING_UPLOAD_CAPACITY_BYTES=209715200
